# Server-only NREMS credentials. Never expose these with NEXT_PUBLIC_ prefixes.
NREMS_USER=
NREMS_PASSWORD=

# Optional overrides
NREMS_BASE_URL=http://nrems.co.kr
NREMS_GROUP_ID=726
NREMS_MANAGER_GROUP_ID=0

# Set to true to return an error instead of demo data when NREMS is unavailable.
NREMS_STRICT=false

# Upstash Redis Free (server-only)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Upstash QStash request verification (server-only)
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
